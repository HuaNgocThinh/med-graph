# MedGraph-VI Environment Configuration

# LLM Provider Configuration (gemini, openai, anthropic, or mock)
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=gemini-1.5-flash

# Neo4j Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medgraph_secret_password

# Entity Linking Settings
RXNAV_API_BASE=https://rxnav.nlm.nih.gov/REST

# Pipeline & Evaluation Settings
LOG_LEVEL=INFO
